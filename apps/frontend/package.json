{
  "name": "@granite-field/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:api": "openapi-ts --silent",
    "check:api": "node scripts/check-api-generated.mjs",
    "check:api:stale": "node scripts/assert-stale-generated-client.mjs",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check:api && npm run check:api:stale && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.0.1",
    "msw": "2.15.0",
    "oxlint": "1.79.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
