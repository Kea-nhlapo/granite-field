{
    "name": "@granite-field/frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "npm@11.19.1",
    "engines": {
        "node": ">=24.13.0 <25",
        "npm": ">=11.6.0 <12"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "oxlint --deny-warnings .",
        "typecheck": "tsc -b --pretty false",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "contracts:check": "node ../../packages/api-contracts/scripts/check-client.mjs",
        "verify": "npm run contracts:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "8.3.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.1.12",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.6",
        "@types/node": "24.13.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.1.0",
        "@vitest/coverage-v8": "4.1.11",
        "jsdom": "29.0.1",
        "oxlint": "1.79.0",
        "prettier": "3.9.6",
        "tailwindcss": "4.1.12",
        "typescript": "6.0.2",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    }
}
