VITE_API_BASE_URL=http://localhost:8080
VITE_API_MODE=live
VITE_TURNSTILE_SITE_KEY=

# Browser-restricted Google Maps JavaScript API key (HTTP referrer restricted
# to this app's deployed domain — never the same key as the backend's
# GOOGLE_MAPS_API_KEY, which is IP-restricted for server-side Directions calls).
VITE_GOOGLE_MAPS_API_KEY=
