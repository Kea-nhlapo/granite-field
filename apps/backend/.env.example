SPRING_PROFILES_DEFAULT=local
TRADEMESH_RUNTIME_ENVIRONMENT=local
LOG_LEVEL_ROOT=INFO
MANAGEMENT_HEALTH_SHOW_DETAILS=never

# Generate a private value of at least 32 random characters. Never commit the
# real value. Access tokens last 15 minutes; refresh tokens rotate on every use.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=https://api.trademesh.local
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P30D

# Guest supplier links are short-lived and rate limited per client address.
SUPPLIER_INVITATION_TTL=P7D
SUPPLIER_INVITATION_VALIDATION_ATTEMPTS=30
SUPPLIER_INVITATION_RATE_LIMIT_WINDOW=PT1M
SUPPLIER_INVITATION_MAX_TRACKED_CLIENTS=10000

# Local MinIO credentials are development-only. Production must provide its
# own S3-compatible endpoint and credentials through secret management.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=trademesh-minio
OBJECT_STORAGE_SECRET_KEY=trademesh-minio
OBJECT_STORAGE_BUCKET=trademesh
OBJECT_STORAGE_MAX_UPLOAD_BYTES=10485760
OBJECT_STORAGE_DOWNLOAD_TTL=PT5M

# The local mock returns deterministic review data. Set this to a real adapter
# name only after that adapter has been added and configured.
DOCUMENT_EXTRACTION_PROVIDER=mock
DOCUMENT_PROCESSING_CLAIM_TIMEOUT=PT5M

# POSTGRES_* configure the local compose container (infra/containers/docker-compose.yml).
# DATABASE_* are what the application connects with. The two halves are separate
# variables because in every non-local environment the database is not ours to
# create and only the DATABASE_* half is set — but locally they must agree, and
# nothing enforces that: change a POSTGRES_* value and change its pair below.
POSTGRES_DB=trademesh
POSTGRES_USER=trademesh
POSTGRES_PASSWORD=trademesh
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/trademesh
DATABASE_USERNAME=trademesh
DATABASE_PASSWORD=trademesh
