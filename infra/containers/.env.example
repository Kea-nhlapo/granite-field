# Copy this file to .env, keep permissions at 0600, and replace every blank
# secret before starting the stack. Docker Compose rejects blank required values.

BACKEND_IMAGE=trademesh-backend:local
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8080

SPRING_PROFILES_DEFAULT=local
TRADEMESH_RUNTIME_ENVIRONMENT=aws-ec2
LOG_LEVEL_ROOT=INFO
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Use at least 32 random characters. This signs access and refresh tokens.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=https://api.trademesh.local

# Generate a Base64-encoded 32-byte value for notification data encryption.
NOTIFICATION_DATA_ENCRYPTION_KEY=

POSTGRES_DB=trademesh
POSTGRES_USER=trademesh
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

OBJECT_STORAGE_ACCESS_KEY=trademesh-minio
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=trademesh
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DOCUMENT_EXTRACTION_PROVIDER=mock
EMAIL_PROVIDER=local
