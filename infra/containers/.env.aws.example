# Cloud deployment environment. Copy to .env on the EC2 host, chmod 600, and fill
# every blank. Only the secrets below are mandatory; every feature setting has a
# working default, so a value nobody has wired yet costs that one feature and
# never stops the service from starting.
#
#   cp .env.aws.example .env && chmod 600 .env
#
# Generate secrets on the host, never in a chat window or a commit:
#   openssl rand -base64 48   -> AUTH_JWT_SECRET
#   openssl rand -base64 32   -> NOTIFICATION_DATA_ENCRYPTION_KEY
#   openssl rand -hex 24      -> POSTGRES_PASSWORD
#   openssl rand -base64 48   -> HANDOVER_QR_SIGNING_SECRET
# Use a different value for each. Never reuse one across settings.

# Set by the deploy pipeline on every release. For a first manual bring-up,
# point it at a tag that exists in ECR.
BACKEND_IMAGE=698251583462.dkr.ecr.af-south-1.amazonaws.com/trademesh-backend:latest
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8080

# Not "local". The local profile supplies fallback credentials and a committed
# encryption key that must never reach a deployed environment.
SPRING_PROFILES_DEFAULT=aws
TRADEMESH_RUNTIME_ENVIRONMENT=aws-ec2
LOG_LEVEL_ROOT=INFO
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=https://api.trademesh.local
NOTIFICATION_DATA_ENCRYPTION_KEY=
# At least 32 characters. Left blank here and generated on the host by the
# release script, which is why a new secret does not need a manual visit.
HANDOVER_QR_SIGNING_SECRET=

POSTGRES_DB=trademesh
POSTGRES_USER=trademesh
POSTGRES_PASSWORD=

# Real Amazon S3. The bucket lives in the same region as the instance.
OBJECT_STORAGE_ENDPOINT=https://s3.af-south-1.amazonaws.com
OBJECT_STORAGE_REGION=af-south-1
OBJECT_STORAGE_BUCKET=
# Credentials of an IAM user scoped to this bucket only. Rotate after the demo.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# clamav | fail-closed | mock. "mock" accepts every upload unscanned and is for
# developer machines only. Unset resolves to fail-closed.
FILE_SCANNER_PROVIDER=clamav

# mock | unconfigured. The mock returns invented CIPC records. Deliberate for the
# demo; swap for a real provider before this handles real business data.
COMPANY_REGISTRY_PROVIDER=mock

DOCUMENT_EXTRACTION_PROVIDER=mock
EMAIL_PROVIDER=local

# Stand-ins: none of these talk to the real service yet. Each is set explicitly so
# the demo works end to end. Removing one leaves that feature failing loudly while
# the rest of the application keeps running.
TURNSTILE_PROVIDER=local
OTP_PROVIDER=local
# The fixed code the local provider accepts. Demo only.
OTP_LOCAL_CODE=000000
MOMO_PROVIDER=mock
DELIVERY_SPEECH_PROVIDER=local
DELIVERY_DISTANCE_PROVIDER=local
MOBILE_NOTIFICATION_PROVIDER=local

# Integration credentials are NOT listed here. They are repository secrets, which
# the pipeline publishes to AWS Parameter Store under /trademesh/, and the release
# script writes into this file on the host. Adding one is a GitHub change, not a
# server visit. Parameter Store owns those keys and overwrites them on every
# release; every other key in .env belongs to the host and is never touched.
#
# Every key in this file reaches the application: docker-compose.aws.yml passes the
# whole file through rather than naming variables one at a time. So a new credential
# needs no change here and no change to the compose file - only the repository
# secret. A secret nothing reads is carried to the host and harmlessly ignored.
#
# Credentials alone change nothing: MOMO_PROVIDER and MOBILE_NOTIFICATION_PROVIDER
# above still select the stand-ins. Switch them to "http" and "twilio" when the
# real integrations are meant to run, and expect real messages and real sandbox
# transactions from that moment.
